{
  "name": "@fearless/aot-transpiler",
  "version": "0.1.0",
  "description": "Transpiles Phase 0 AOT-eligible Fearless handlers to Rust source.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/mod.rs": "./src/runtime/mod.rs"
  },
  "files": [
    "dist",
    "src/runtime/mod.rs"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fearless/aot-analyzer": "0.1.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
