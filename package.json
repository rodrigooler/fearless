{
  "name": "microu",
  "version": "0.3.0",
  "description": "TypeScript microframework with a hybrid Rust+Bun runtime. Functional handler API + lifecycle hooks. Declarative routes execute on a Rust core; handlers execute on Bun.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dependencies": {
      "types": "./dist/dependencies/index.d.ts",
      "import": "./dist/dependencies/index.js"
    },
    "./dependencies/cors": {
      "types": "./dist/dependencies/cors.d.ts",
      "import": "./dist/dependencies/cors.js"
    },
    "./dependencies/security": {
      "types": "./dist/dependencies/security.d.ts",
      "import": "./dist/dependencies/security.js"
    }
  },
  "files": [
    "dist",
    "rust-core/src",
    "rust-core/Cargo.toml",
    "rust-core/Cargo.lock",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsx watch examples/basic.ts",
    "start": "node dist/examples/basic.js",
    "lint": "oxlint -c .oxlintrc.json src test",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src test",
    "bench:load": "tsx bench/load.ts",
    "bench:micro": "tsx bench/micro.ts",
    "test:js": "node --import tsx --test",
    "test:rust": "cargo test --manifest-path rust-core/Cargo.toml --no-run",
    "test": "npm run test:js && npm run test:rust",
    "bench:tfb": "node ./scripts/bench-tfb.mjs"
  },
  "keywords": [
    "microframework",
    "framework",
    "http",
    "server",
    "rust",
    "bun",
    "typescript",
    "io_uring",
    "performance",
    "handler",
    "routing",
    "techempower",
    "fastify-alternative",
    "express-alternative"
  ],
  "author": "Rodrigo Oler",
  "license": "MIT",
  "homepage": "https://github.com/rodrigooler/fearless#readme",
  "bugs": {
    "url": "https://github.com/rodrigooler/fearless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigooler/fearless.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autocannon": "^8.0.0",
    "oxlint": "^1.63.0",
    "tinybench": "^2.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
