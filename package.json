{
  "name": "microu",
  "version": "1.0.0",
  "description": "Fast, minimalist Node.js framework powered by uWebSockets.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsx watch examples/basic.ts",
    "start": "node dist/examples/basic.js",
    "test:js": "node --import tsx --test",
    "test:rust": "cargo test --manifest-path rust-core/Cargo.toml",
    "test": "npm run test:js && npm run test:rust",
    "bench": "fnm exec --using=v22.22.1 tsx bench/run.ts"
  },
  "dependencies": {
    "arktype": "^2.0.0-rc.27",
    "elysia": "^1.4.28",
    "uWebSockets.js": "uNetworking/uWebSockets.js#v20.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autocannon": "^8.0.0",
    "elysia": "^1.4.28",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
